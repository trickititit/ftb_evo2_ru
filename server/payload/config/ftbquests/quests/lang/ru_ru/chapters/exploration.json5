{
  "quest.7F0A4B19ED4DF750.quest_desc": [
    "Пять из восьми биомов Incendium. Посетите каждый."
  ],
  "quest.18DE042E91A96693.quest_desc": [
    "Мавзолеи, черные спирали, призрачные руины, увядающие пещеры и гниющие храмы — все это скрывает &cСангвинического Торговца&r.",
    "",
    "В наличии: Neo Vitae руны и реагенты, EvilCraft темные драгоценные камни и кроваво-вощеный уголь, а также Кровавая жемчужина телепортации.",
    "{@pagebreak}",
    "&bМестоположения:&r Мавзолей, Черная Спираль (Исследовать), Призрачные руины, Увядающая пещера, Гниющий храм (ATI)",
    "",
    "&dРазблокировка:&r Получите Ara Vitae"
  ],
  "quest.167F48E2584A3022.title": "&cМог и Галг",
  "quest.506CE8202884EF43.quest_desc": [
    "Биом Конца Resonance, полный огромных жеод и аметистовых шпилей."
  ],
  "quest.7638D24AFD676A7F.quest_desc": [
    "Храмы Муга в джунглях намного больше, чем в ванильных храмах, а комнату с сокровищами охраняет головоломка.",
    "",
    "Решите ее, чтобы получить хороший шанс попасть в Тотем бессмертия или Зачарованное золотое яблоко."
  ],
  "quest.15DA8CCB11B85EA6.quest_desc": [
    "Ищите каменный храм на поверхности. Шахта под ним ведет в большое подземелье примерно в 47 кварталах вниз.",
    "",
    "Ящики с добычей бывают пяти уровней, и легендарные могут содержать броню и инструменты богоуровня с чарами, намного превышающими их обычный максимум.",
    "",
    "&cНекоторые сундуки наполнены тротилом."
  ],
  "quest.170CF50988CB58E6.quest_desc": [
    "Небесные арены плавают между 120 и 170 годами. Они работают как испытательные камеры, с испытательными генераторами, из которых сбрасываются пробные ключи для хранилищ.",
    "",
    "В хранилищах хранятся алмазное снаряжение и отделка брони «Болт», а также гарантированная Зловещая бутылка."
  ],
  "quest.5AB13D8A178233DD.quest_desc": [
    "Крепости здесь представляют собой перестроенные версии, полные генераторов, библиотек и арсеналов, а комната с порталом Края все еще ждет внизу.",
    "",
    "Глаза Эндера, как обычно, приведут вас к одному из них."
  ],
  "quest.388CACAF16133436.quest_desc": [
    "Озера окружены желтой, оранжевой и черной землей, между ними находится магма и жерла. Смотри, куда ты ступаешь."
  ],
  "quest.409A27E9A4A6941D.quest_desc": [
    "Возьмите перевернутую карту Таро Смерти, и каждая ночь с вероятностью 15% принесет &cСмерть&r.",
    "",
    "У него 1000 здоровья, и ни один удар по нему не наносит больше 16 урона. Он роняет капюшон, халат, обувь и серп."
  ],
  "quest.34FF9A882AA4ABCB.title": "&3Древние города",
  "quest.55B3900E2E519129.quest_desc": [
    "Маленькие корабли и древние суда несут &9Swashbuckler&r.",
    "",
    "В наличии: огнестрельное оружие, боеприпасы и модификаторы оружия Iron's Arms 'n Artifice, а также тротил и ящик с добычей.",
    "{@pagebreak}",
    "&bМестоположения:&r Малый корабль (MVS), Древнее судно (ATi)",
    "",
    "&dРазблокировка:&r Победите стрелка или выиграйте дуэль стрелков. "
  ],
  "quest.7F59F90B1B6F9A67.title": "&bЛедяной Дракон",
  "quest.7AE9316511656205.quest_subtitle": "Путник, Ювелир и Повелитель зверей",
  "quest.4E77F883F5F8C4E7.quest_subtitle": "Интендант, Машинист, Бакалейщик и Пчеловод.",
  "quest.20393692539B1184.quest_desc": [
    "Ужасные мавзолеи стоят в заснеженных биомах, кишащие источниками ужаса. Дверь остается запертой, пока вы не принесете ключ."
  ],
  "quest.19ADE41D01CF22B7.title": "&dМолниеносный Дракон",
  "quest.7465320331494BD7.title": "&6Пещеры Дракона",
  "quest.6B87A87B53F85BD4.title": "&9Лунная роща",
  "quest.21D5042B16907B90.quest_desc": [
    "Подводная версия каменных подземелий, построенная под дном океана между -24 и 24 годами. Страж утонул, а бродячие создатели охраняют его.",
    "",
    "Его ящики с добычей добавляют океанское снаряжение к обычным пяти уровням."
  ],
  "quest.269CA7E3614C0826.quest_desc": [
    "Морские змеи охотятся в открытом океане и прыгают на лодки. Древние достигают 270 здоровья."
  ],
  "quest.5758A01C78625749.quest_desc": [
    "Ищите &2Хеджевую ведьму&r в хижинах ведьм, хижинах мангровых зарослей, небольших болотных домиках и поселениях темных лесов.",
    "",
    "Ассортимент: Witchery и Roots Классические принадлежности, включая семена ведьминских растений, крючки, куклы, ритуальный мел и мутандис.",
    "{@pagebreak}",
    "&bЛокации:&r Хижина ведьмы (Терралит), Хижина в мангровых зарослях (Исследовать), Маленький болотный домик (МВС), Темное поселение (Исследовать)",
    "",
    "&dРазблокировка:&r Получите Witchery Путеводитель или Зеленую веточку."
  ],
  "quest.2965565D68C9761B.quest_desc": [
    "Затонувший корабль со Стражем на борту и одиннадцатью сундуками, которые нужно разграбить."
  ],
  "quest.7B828C91840C23A5.quest_desc": [
    "&cHovering Inferno&r — это пламя с 700 здоровья и 20 брони, и оно несет Тотем бессмертия, поэтому планируйте убить его дважды.",
    "",
    "Из него выпадает два артефакта из &eIncendium&r."
  ],
  "quest.4FE64D008CCF0CA2.title": "&bСкайлендс",
  "quest.250945907CE6EA9D.quest_desc": [
    "Дракон ничего не теряет, когда умирает. Щелкните тело правой кнопкой мыши, чтобы собрать его, и каждый сбор дает что-то новое.",
    "",
    "Чешуя и кровь на первом месте, поэтому возьмите с собой стеклянные бутылки. Далее следуют кости, затем сердце и череп с последним урожаем."
  ],
  "quest.693BD17350005AC9.title": "&dГолова Горгоны",
  "quest.15DA8CCB11B85EA6.title": "&aКаменные подземелья",
  "quest.1F842D40F39C5763.quest_desc": [
    "Крупнейшие руины в глубинах океана. Утонувшие испытательные спаунеры охраняют сундуки с трезубцами, алмазным снаряжением и отделкой береговой брони."
  ],
  "quest.1F842D40F39C5763.title": "&3Подводный город",
  "quest.409A27E9A4A6941D.title": "&cСмерть",
  "quest.7D5121F9B867A99D.quest_desc": [
    "У &cКороля Грома&r 350 единиц здоровья и 10 единиц брони, и он получает половину урона, пока вызывает шторм.",
    "",
    "Из него выпадает полный комплект королевской брони и королевская глефа."
  ],
  "quest.42348582DFB34EA1.quest_desc": [
    "Incendium восстанавливает Пустоту. Пять ванильных биомов все еще существуют, и к ним присоединяются восемь новых."
  ],
  "quest.7AE9316511656205.quest_desc": [
    "Таверны Explorify — самая оживленная остановка на дороге: внутри находятся четыре владельца магазина.",
    "",
    "- &6Путешественник&r: дорожное снаряжение, от путевых камней и свитков деформации до компасов, параплана и кроссовок.",
    "- &dЮвелир&r: символы Апофеоза, футляры с драгоценными камнями, фолианты и ремесленные свитки.",
    "- &cПовелитель зверей&r: части фермы мобов, пилоны, руны спауна и генератор монстров.",
    "",
    "Путешественник продает &aПриродный компас&r и &2Компас исследователя&r, которые можно найти во всех остальных местах в этой главе.",
    "{@pagebreak}",
    "&bМестоположение:&r Таверна (Исследовать)",
    "",
    "&dРазблокировка:&r ",
    "&6Путешественник&r — Получите варп-камень, параплан или компас Natures/Explorers.",
    "&dЮвелир&r - Постройте станцию ювелирного дела.",
    "&cBeastmaster&r — Создайте бестиарий."
  ],
  "quest.73127D9218A217CB.title": "&cГидра",
  "quest.7F209ECB076B2B30.quest_desc": [
    "В мире полно построек, и в этой главе перечислены те, которые стоят того, чтобы посетить их. Вас ждут подземелья, арены с боссами и добыча, которую вы больше нигде не найдете.",
    "",
    "&aКомпас исследователя&r указывает на ближайшее строение любого выбранного вами типа на расстоянии до 10 000 блоков. Большинство заданий здесь выполняются, как только вы входите внутрь сооружения.",
    "",
    "&cДраконы, сирены, циклопы и другие опасные Ice and Fire существа никогда не появляются в радиусе 2000 блоков от места появления в мире."
  ],
  "quest.30C87E5D353137F6.quest_desc": [
    "Рогатые статуи прячутся под землей на большей части земного мира. Обменяйте его изумрудами и &aЭссенция&r на &2Сосуд выносливости&r, который повышает выносливость вашего параплана.",
    "",
    "Он также выкупает суда обратно, если вы передумаете."
  ],
  "quest.42348582DFB34EA1.title": "&cПустота",
  "quest.6EFD9C957BD47563.quest_desc": [
    "Ужасающие личи бродят по заснеженным биомам и роняют &bКлюч распорядителя могил&r один раз из десяти. Он открывает замочную скважину мавзолея.",
    "",
    "В сундуках внутри может храниться сердце ледяного дракона."
  ],
  "quest.6933686D0F959FAA.title": "&cОгненный Дракон",
  "quest.6933686D0F959FAA.quest_desc": [
    "У насестного дракона от 1100 до 1200 единиц здоровья, а дыхание огненного дракона поджигает землю вокруг вас."
  ],
  "quest.7638D24AFD676A7F.title": "&aХрамы в джунглях",
  "quest.569357C95D1210AA.quest_desc": [
    "Несколько &eNautec&r шлюзов уже находятся на морском дне, каждый на небольшой призмариновой платформе в открытом океане. Все они носят одинаковый четырехцветный адрес.",
    "",
    "Щелкните правой кнопкой мыши по плавнику пустой рукой, чтобы прочитать этот адрес. Врата, которые вы построите и покрасите в соответствии с ними, смогут добраться до них."
  ],
  "quest.15C698B306B3B577.title": "&cЦиклоп",
  "quest.24D8E1226694FEED.title": "&cЛеонард",
  "quest.506CE8202884EF43.title": "&dКристаллизованный конец",
  "quest.1BF72D9D4ECB46B8.quest_desc": [
    "В редком сундуке в храме Незера всегда находится шаблон улучшения незерита, что позволяет сэкономить много времени на охоте на бастион."
  ],
  "quest.1D86C25D8DDA3F1E.title": "&cНезер Арены",
  "quest.1D96D2FF800AE80A.title": "&3Океанские храмы",
  "quest.15C698B306B3B577.quest_desc": [
    "У &cЦиклопа&r 250 единиц здоровья и он сильно бьет. Стрела в глаз ослепляет его, а полная овечья маскировка скроет вас, пока вы крадетесь."
  ],
  "quest.4FE64D008CCF0CA2.quest_desc": [
    "Плавающие острова с озерами и водопадами, висящие над океаном. У Terralith есть весенняя, летняя, осенняя и зимняя версии, и любая из них имеет значение.",
    "",
    "&aПриродный компас&r находит любой биом по названию. Путник продает один."
  ],
  "quest.693BD17350005AC9.quest_desc": [
    "Взгляд &cГоргоны&r превращает вас в камень. Наденьте &aГлазная повязка&r или выпейте Зелье слепоты, прежде чем спуститься вниз. Зеркала не помогают.",
    "",
    "У нее 120 единиц здоровья, и она всегда роняет голову."
  ],
  "quest.2C3ED0622537D3DD.title": "&cМега Крепость",
  "quest.6B9AD6056DC2E540.quest_desc": [
    "Пещеры циклопов высечены на пляжах, и циклопы также бродят по равнинам и лугам."
  ],
  "quest.1FF99FC384C22A24.quest_desc": [
    "Самый большой тайник с добычей в Крае, с четырнадцатью сундуками с сокровищами Края, за гарнизоном шалкеров."
  ],
  "quest.40892A92CA977BA0.quest_desc": [
    "Склоны вулкана, по которым стекают источники лавы."
  ],
  "quest.502E257ED1246812.quest_desc": [
    "Пещеры Гидры вырыты в болотах и мангровых зарослях."
  ],
  "quest.7465320331494BD7.quest_desc": [
    "Самые старые драконы спят в пещерах глубоко под землей, между -24 и 5 годами, на кладах гораздо больших, чем любые норы.",
    "",
    "&cЗдоровье пещерных драконов может достигать около 2500."
  ],
  "quest.21D5042B16907B90.title": "&3Подземелья Глубоких Слейтов",
  "quest.2B5ECE4CD3F8412B.title": "&3Рыботорговец",
  "quest.170CF50988CB58E6.title": "&aНебесные арены",
  "quest.2913824ED3340F93.title": "&3Nautec Руины",
  "quest.1A235CAF42A6F6A0.title": "&5Дальний конец",
  "quest.34FF9A882AA4ABCB.quest_desc": [
    "Древние города здесь представляют собой более крупные переработанные версии, а в их сундуках можно найти осколки эха, зачарованные золотые яблоки и отделку брони «Безмолвие».",
    "",
    "Скалки-крикуны зовут Стража."
  ],
  "quest.342991AE8AC9BC34.title": "&cЗапретный замок",
  "quest.5EBF7DD6E28CBBCD.quest_desc": [
    "Подземелья Dungeon Crawl состоят из пяти уровней, а самый глубокий уровень посвящен теме Пустоты. В спавнетерах есть вооруженные мобы, а в секретных комнатах спрятаны одни из лучших сундуков.",
    "",
    "Сокровищница выплачивает стопки золота, а иногда и Зачарованное Золотое Яблоко."
  ],
  "quest.124F536BB57E1365.quest_desc": [
    "Песня &cSiren&r тянет вас к ней. Наденьте &aБеруши&r, и он не сможет вас коснуться.",
    "",
    "Сирены роняют слезы сирены и блестящую чешую."
  ],
  "quest.342991AE8AC9BC34.quest_desc": [
    "Глубоко в Пепельных Пустошах стоит самая большая постройка &eIncendium&r. Его держат звери-пиглины и пылающие часовые, а на его подставках изображен Алый Кинжал или Большой Меч Жертвоприношения."
  ],
  "quest.1BF72D9D4ECB46B8.title": "&cХрам Незера",
  "quest.569357C95D1210AA.title": "&3Затонувшие врата",
  "quest.49A2DD994F720F84.quest_desc": [
    "Версия каменных подземелий Незера, между 24 и 90 годами. Пылающие, скелеты-иссушители и производители зверей-свиней охраняют свой собственный стол с добычей для крупных игроков."
  ],
  "quest.203E01E473B7DCFA.title": "&cРогатый Охотник",
  "quest.33D0A75727D9CB58.quest_subtitle": "Привратник и игрок",
  "quest.656B7E686D7EBBE4.title": "&bГрозовой Двор",
  "quest.49A2DD994F720F84.title": "&cПодземелья Незера",
  "quest.7F59F90B1B6F9A67.quest_desc": [
    "Дыхание ледяного дракона замораживает все, к чему прикасается, включая вас. Продолжайте двигаться, чтобы он не смог прижать вас к месту."
  ],
  "quest.5758A01C78625749.title": "&2Деревенская ведьма",
  "quest.57A55BDA10B81ACB.title": "&dКонец",
  "quest.57A55BDA10B81ACB.quest_desc": [
    "За главным островом большая часть внешнего Края принадлежит биомам Nullscape и Resonance."
  ],
  "quest.5A03706C37C733CE.title": "&dЧародей",
  "quest.5AB13D8A178233DD.title": "&aКрепости",
  "quest.4E77F883F5F8C4E7.quest_desc": [
    "Владельцы магазинов обосновались на своих местах. Зайдите в деревню, и их прибудет до четырех человек, каждому из которых будет отправлено сообщение в чат. Щелкните правой кнопкой мыши продавца с пустой рукой, чтобы открыть его магазин.",
    "",
    "- &bИнтендант&r: улучшения рюкзака и хранилища, ящики и стартовые детали для AE2 и изысканного хранилища.",
    "- &cМашинист&r: детали машин из технических модов и бесконечные ячейки.",
    "- &aБакалейщик&r: семена, урожай, яйца спауна сельскохозяйственных животных и кухонные инструменты.",
    "- &6Пчеловод&r: пчелиные клетки, гнезда и улучшения ульев. Пчеловод приходит только в деревни, расположенные на равнинах, подсолнечниковых равнинах, лугах и в биомах саванны.",
    "{@pagebreak}",
    "&bМестоположение:&r Деревни",
    "",
    "&dРазблокировка:&r ",
    "&bИнтендант&r — Улучшите рюкзак или сундук.",
    "&cМашинист&r — Создайте любую базовую схему.",
    "&aБакалейщик&r - Съешь что-нибудь.",
    "&6Пчеловод&r - Поймайте пчелу в клетку."
  ],
  "quest.1754F4058CB200D4.title": "&dИскатель драконов",
  "quest.19ADE41D01CF22B7.quest_desc": [
    "Драконы-молнии призывают удары своим дыханием. Они наиболее распространены из трех, поэтому вы, скорее всего, встретите одного из них первым."
  ],
  "quest.33D0A75727D9CB58.title": "&6Торговцы поместья",
  "quest.46EEC36A2FA7A0D0.title": "&dМиражные острова",
  "quest.388CACAF16133436.title": "&6Йеллоустоун",
  "quest.250945907CE6EA9D.title": "&6Добыча дракона",
  "quest.203E01E473B7DCFA.quest_desc": [
    "Постройте плетеного человечка из окровавленного сена и подожгите его кремнем и сталью, и ответит &cРогатый Охотник&r.",
    "",
    "У него 150 единиц здоровья, и из него выпадает Копье Охотника."
  ],
  "quest.1754F4058CB200D4.quest_desc": [
    "&dИскатель Драконов&r укажет вам на ближайшего дракона. По мере улучшения его дальность увеличивается со 150 блоков до 300.",
    "",
    "Он находит драконов только в загруженных кусках, поэтому используйте его на ходу."
  ],
  "quest.656B7E686D7EBBE4.quest_desc": [
    "Громовые Дворы расположены на равнинах, лугах и в лесах, и каждый из них содержит одного &cКороля Грома&r."
  ],
  "quest.7F0A4B19ED4DF750.title": "&cДикие Пустоты",
  "quest.7EE3B916522A9170.title": "&aХрам Горгоны",
  "quest.5EBF7DD6E28CBBCD.title": "&aПолзание по подземельям",
  "quest.2B5ECE4CD3F8412B.quest_desc": [
    "В подводных храмах находится магазин &3Рыбного торговца&r.",
    "",
    "Рыболовные снасти и наживка для Starcatcher, детали Nautec и культуры бактерий, а также аквариумы.",
    "",
    "Принесите способ дышать под водой.",
    "{@pagebreak}",
    "&bМестоположения:&r Храм подводной деревни (неповрежденный, сломанный или разрушенный) ",
    "",
    "&dРазблокировка:&r Поймай рыбу."
  ],
  "quest.7AE9316511656205.title": "&6Завсегдатаи таверны",
  "quest.1D86C25D8DDA3F1E.quest_desc": [
    "Испытательные камеры Пустоты со скелетом-иссушителем, пламенем и испытательными генераторами кубов магмы, охраняющими хранилища.",
    "",
    "В хранилищах редкой Арены Дракона можно хранить тяжелое ядро."
  ],
  "quest.7B828C91840C23A5.title": "&6Парящий ад",
  "quest.7D5121F9B867A99D.title": "&6Король Грома",
  "quest.2C3ED0622537D3DD.quest_desc": [
    "Огромная крепость, которая может появиться где угодно в Пустоте. В его сундуках можно хранить слитки незерита и шаблоны улучшений."
  ],
  "quest.319428452110100A.quest_desc": [
    "Мегакорабли Муга дрейфуют через внешний Край с капитаном-скелетом-иссушителем на борту.",
    "",
    "Они несут надкрылья в рамках предметов, поэтому они являются вторым источником надкрылий, помимо конечных городов."
  ],
  "quest.6EFD9C957BD47563.title": "&bКлюч могильщика",
  "quest.120E37CE2AB140FA.title": "&cАдский алтарь",
  "quest.7063420D36849583.quest_desc": [
    "Острова Сирены возвышаются над открытым океаном. Прислушайтесь к пению, прежде чем увидеть их."
  ],
  "quest.120E37CE2AB140FA.quest_desc": [
    "Адский Алтарь стоит в Адских Дюнах. Бросьте в него Звезду Пустоты, чтобы призвать ее стража."
  ],
  "quest.269CA7E3614C0826.title": "&cМорские змеи",
  "quest.6A7DB2334016638A.quest_desc": [
    "Взрослые драконы гнездятся на поверхности на куче сокровищ. Огненные драконы живут в пустынях и на вулканических землях, ледяные драконы — в снежных биомах, а молниеносные драконы — в джунглях, бесплодных землях, саваннах и болотах.",
    "",
    "Огненные и ледяные драконы спят ночью, драконы-молнии – днем. Ваш первый удар разбудит их."
  ],
  "quest.1A235CAF42A6F6A0.quest_desc": [
    "Три биома Nullscape в пустоте.",
    "",
    "- &0Shadowlands&r: чёрный камень и базальт с костяными деревьями.",
    "- &7Пустоты&r: голый камень Края и немного больше.",
    "- &bКристальные Пики&r: кристаллические образования."
  ],
  "quest.24D8E1226694FEED.quest_desc": [
    "&cЛеонард&r добывается из котла, для которого нужна шляпа ведьмы. У него 500 единиц здоровья, он сражается в три фазы и роняет Урну Леонарда."
  ],
  "quest.502E257ED1246812.title": "&aПещера Гидры",
  "quest.25975DB5C7ADE870.quest_desc": [
    "&cСтарший страж&r охраняет каждый океанский храм и памятник. Его проклятие замедляет добычу полезных ископаемых, поэтому убейте его, прежде чем начнете ломать стены."
  ],
  "quest.18DE042E91A96693.title": "&cТорговец кровью",
  "quest.30C87E5D353137F6.title": "&aРогатая статуя",
  "quest.33D0A75727D9CB58.quest_desc": [
    "В поместьях и мраморных замках расположены самые дорогие магазины стаи.",
    "",
    "- &6Привратник&r: Жемчуг врат, пробные ключи и призыватель апотических захватчиков.",
    "- &6Игрок&r: ящики с добычей от 25 до 750 монет. Он торгует только после того, как вы откроете собственный ящик с добычей.",
    "",
    "{@pagebreak}",
    "&bМестоположения:&r Усадьба, Мраморный замок (ATi)",
    "",
    "&dРазблокировка:&r ",
    "GateKeeper — получить шлюз, ",
    "Игрок — открыть ящик с добычей"
  ],
  "quest.6A7DB2334016638A.title": "&6Драконьи насесты",
  "quest.20393692539B1184.title": "&bМавзолей Ужаса",
  "quest.7F209ECB076B2B30.title": "&6Исследование мира",
  "quest.167F48E2584A3022.quest_desc": [
    "Дайте статуе Покровителя Хобгоблинов Звезду Пустоты, и &cМог&r и &cГалг&r прибудут вместе, имея по 400 единиц здоровья каждый.",
    "",
    "Из них падают Колчан Мога и Решетка Галга."
  ],
  "quest.7EE3B916522A9170.quest_desc": [
    "Храмы Горгон стоят на пляжах. Горгона ждет в подвале, за люком, который открывается."
  ],
  "quest.2965565D68C9761B.title": "&3Древний сосуд",
  "quest.2913824ED3340F93.quest_desc": [
    "Небольшие темные призмариновые руины усеивают дно океана, и в каждой арке все еще находится работающий &aВодный катализатор&r. Этот катализатор — ваш первый лазер, и именно с него вы начнете создавать лазерные предметы в &eNautec&r.",
    "",
    "Разбейте его и отнесите домой. В &aРжавый ящик&r рядом с ним хранятся &2Призмариновые лазерные реле&r и другие детали, но его замок проржавел. Бросьте его в &2Травящая кислота&r, чтобы очистить, затем откройте чистый &aЯщик&r, как сундук. Протирая &aПодозрительный гравий&r вокруг руин, вы обнаружите те же самые части."
  ],
  "quest.1FF99FC384C22A24.title": "&dВнутренний двор Крепости Эндер",
  "task.6BADEBBA351BFE5C.title": "Любой череп дракона",
  "quest.4E77F883F5F8C4E7.title": "&6Деревенские торговцы",
  "quest.6B87A87B53F85BD4.quest_desc": [
    "Лес голубых цветов с аметистами, растущими из земли."
  ],
  "quest.1D96D2FF800AE80A.quest_desc": [
    "Океанские храмы Муга расположены на глубоководном морском дне. В сокровищнице один раз из четырех находится Сердце Моря."
  ],
  "quest.7063420D36849583.title": "&aОстров Сирены",
  "quest.46EEC36A2FA7A0D0.quest_desc": [
    "Острова зачарованных деревьев и гигантских грибов далеко в глубоком океане."
  ],
  "quest.25975DB5C7ADE870.title": "&cСтарший страж",
  "quest.6B9AD6056DC2E540.title": "&aПещера Циклопа",
  "quest.124F536BB57E1365.title": "&cСирены",
  "quest.55B3900E2E519129.title": "&9Сорвиголова",
  "quest.40892A92CA977BA0.title": "&cВулканические вершины",
  "quest.5A03706C37C733CE.quest_desc": [
    "Башни и комплексы магов Терралита являются домом для &dАрканиста&r.",
    "",
    "В наличии: Ars Magica реагенты и руны, магическая броня и фолианты Affinity, а также несколько предметов-сердец из канистр Baubley Heart Canisters.",
    "{@pagebreak}",
    "&bМестоположения:&r Башня Магов, Комплекс Магов (Терралит)",
    "",
    "&dРазблокировка:&r Получите пыль Винтеума."
  ],
  "quest.319428452110100A.title": "&dМега Корабли",
  "quest.73127D9218A217CB.quest_desc": [
    "У &cГидры&r 550 единиц здоровья. Каждая отрубленная голова вырастает снова в количестве двух, вплоть до девяти, и заживает, если не горит.",
    "",
    "Подожгите его и поддерживайте горение."
  ],
  "task.52CD1A19C7C03226.title": "Посетите любой биом Skylands"
}
