{
  "quest.1CA8D89EE7C50CFD.title": "&fУбить 10 &dШалкеров",
  "task.58687506041183E7.title": "&eУбить&r: &cСлизи",
  "quest.34C8824842867F5D.quest_desc": [
    "&dЭндер-Дракон&r не остаётся мёртвым. Поместите четыре &aКристалла Края&r по краю выходного портала, чтобы вызвать его снова."
  ],
  "quest.3D687BF735E54AE8.quest_desc": [
    "&cПламя&r появляются вокруг своих источников в &cКрепостях Пустоты&r. Снежки ранят их, а зелье сопротивления огню устраняет большую часть опасности в бою."
  ],
  "quest.24445EC4DA6492F1.title": "&dГерой деревни",
  "task.61C0F35123FBB85E.title": "&fУбить: 1x &dСтраж",
  "quest.0D35D0D33922A201.title": "&fПобедить 10 &dВрата в вечность",
  "quest.782CCA40CEBC135A.quest_desc": [
    "Создайте спаунер с минимальными задержками, который имеет контроль красного камня, не имеет искусственного интеллекта, игнорирует условия появления и игнорирует игроков."
  ],
  "task.4087591E474FC477.title": "&fУбить 10 &dЭндермены",
  "quest.59C71582F19E8554.quest_desc": [
    "Самая простая награда на доске. Учитываются только обычные &cЗомби&r, поэтому шелухи, утопленники и зомби-жители к этому не добавятся."
  ],
  "quest.7D23D1C9DE75721F.title": "&fУбить 20 &cСкелеты",
  "task.4335140E412572D8.title": "&fПобедить 10 &dВрата в вечность",
  "quest.1237537100194BED.quest_desc": [
    "Будучи второстепенным божеством разложения, &6звёзды&r, брошенные побежденным &dИссушителем&r, становятся всё более распространённым требованием достоинства.",
    "",
    "Призывается путем размещения 3 черепов скелетов-иссушителей на букву «Т» из 4 песков душ.",
    "",
    "{image:minecraft:textures/painting/wither.png width:100 height:100 align:center}"
  ],
  "task.268F689AFA620C03.title": "&eУбийство&r: &cСкелеты",
  "quest.5C2C0986D6014ADD.title": "&6Странствующий торговец",
  "quest.20D7DA6055C540FA.quest_desc": [
    "Эта глава заданий содержит повторяющиеся задания, которые вы можете выполнить за дополнительные деньги, которые можно потратить в магазинах."
  ],
  "quest.232E1BBB91DEF799.quest_subtitle": "Вы пережили 100 дней в FTB Evolution 2",
  "quest.5918EA666DF20DA4.quest_subtitle": "Только что победил стаю... Что ты так долго?",
  "task.7B71A001741520D3.title": "&eУбить&r: &cСкелеты-иссушители",
  "quest.708DD6CD3AE7F0FE.quest_desc": [
    "Разложившиеся стражи нижних крепостей"
  ],
  "quest.782CCA40CEBC135A.title": "Предельный спаунер",
  "quest.1CA8D89EE7C50CFD.quest_desc": [
    "Укрытые часовые крайних городов."
  ],
  "quest.3D687BF735E54AE8.title": "&fУбить 10 &cПылает",
  "quest.49540656967A58DC.title": "Играйте 1 час",
  "quest.49540656967A58DC.quest_desc": [
    "Каждая минута, которую вы проводите в этом мире, засчитывается в награду за игру, даже те минуты, которые вы проводите, стоя на месте."
  ],
  "quest.77F964631F38EA2E.title": "&fУбить 20 &cКриперс",
  "quest.54E74795E1F9F9F2.title": "Играйте &c25 часов",
  "task.491E250D69066BBC.title": "&fУбийство: 1x &dУвядание",
  "task.3F437642D1B08EBF.title": "&eУбить&r: &cПауки",
  "quest.5918EA666DF20DA4.title": "Играйте &z1000 часов",
  "task.5B97CEFB80FF361B.title": "&fУбить 10 &dШалкеров",
  "quest.67078BCAD52BC4B4.quest_desc": [
    "Большие слизни распадаются, когда умирают, и каждый убитый вами кусочек имеет значение. Ищите в болотах и ​​глубоко под землей куски слизи."
  ],
  "quest.29E78B39C74FBC4E.title": "Убейте одного из каждого враждебного моба",
  "quest.05B051603AC63B5A.title": "Предельное зачарование",
  "quest.6E5CEEE43F0DECA7.quest_desc": [
    "Во время исследования соберите 100 &eLootr&r бочек."
  ],
  "quest.3E0191A718C8CFF9.quest_subtitle": "Проживите 24 часа без смертей",
  "quest.0D35D0D33922A201.quest_desc": [
    "&aЖемчужина врат&r открывает врата, которые посылают на вас волны мобов, а JEI показывает, как создать каждый из них.",
    "",
    "Шлюз выходит из строя, если моб не может появиться, моб уходит слишком далеко или таймер волны истекает, поэтому открывайте его на ровной открытой местности."
  ],
  "quest.1F70A066744E64EA.quest_desc": [
    "Пятьдесят часов. Хорошее время, чтобы проверить, чего хочет от вас &aFTB Skyline&r."
  ],
  "quest.3E0191A718C8CFF9.quest_desc": [
    "Часы отсчитывают время с момента вашей последней смерти, и только пока вы вошли в систему. Умрите один раз, и все начнется с нуля."
  ],
  "quest.54E74795E1F9F9F2.quest_desc": [
    "Двадцать пять часов. Если ваша база все еще работает на стартер-генераторах, это знак того, что вам пора обновиться."
  ],
  "quest.43B65AF71961292F.quest_desc": [
    "Сто часов в одном мире. Отдохните, пачка никуда не денется."
  ],
  "task.4BEC99EFB3F7A310.title": "&bВыживает сильнейший",
  "quest.1237537100194BED.title": "&fУбить &dУвядание",
  "task.6347BBAD2ED20F25.title": "&eУбить&r: &cЗомби",
  "quest.6DC738A434C5B02F.title": "&fУбить 10 &dЭндермены",
  "quest.43B65AF71961292F.title": "Играйте &6100 часов",
  "quest.232E1BBB91DEF799.title": "Играйте &z100 дней",
  "quest.6964408274A7ACF7.quest_desc": [
    "Прошло десять часов. К настоящему времени у вас должно быть электричество и база, на которую стоит вернуться домой."
  ],
  "task.79684EDD87FFB47C.title": "&eУбить&r: &cКриперс",
  "quest.3E0191A718C8CFF9.title": "&bВыживает сильнейший",
  "quest.59C71582F19E8554.title": "&fУбить 20 &cЗомби",
  "quest.43B65AF71961292F.quest_subtitle": "Пора подышать свежим воздухом",
  "quest.644DADBCF755057C.quest_desc": [
    "Получите Печать превосходства на волне 100 Бесконечных врат апотических захватчиков."
  ],
  "quest.2EE5352D8E5F715F.quest_desc": [
    "Учитываются только обычные пауки; Пещерные пауки - это другой моб. Днем они оставят вас в покое, если вы не ударите их первым."
  ],
  "quest.6DC738A434C5B02F.quest_desc": [
    "Посмотрите на одного, чтобы разозлить его, а затем нырните под потолок высотой в два блока. &dЭндермен&r слишком высок, чтобы следовать за вами."
  ],
  "quest.24445EC4DA6492F1.quest_subtitle": "Защитите деревню от набега",
  "quest.29E78B39C74FBC4E.quest_desc": [
    "Это ванильное продвижение Monsters Hunted. Ему нужен 41 различный моб, включая &dЭндер-Дракон&r, &5Иссушитель&r и &cСтарший Страж&r, так что это занимает некоторое время.",
    "",
    "В списке только ванильные мобы. Экран «Дополнения» показывает ваш прогресс."
  ],
  "quest.1F70A066744E64EA.title": "Играйте &d50 часов",
  "quest.24445EC4DA6492F1.quest_desc": [
    "Вам понадобится &cПлохое предзнаменование&r, чтобы начать рейд. С капитанов рейдов падают &cЗловещие бутылки&r; выпейте одну возле деревни, затем держите линию."
  ],
  "quest.232E1BBB91DEF799.quest_desc": [
    "Это 2400 часов игрового времени. Никто не ожидает, что он закончит это дело."
  ],
  "quest.7A8669713BE28E8F.title": "&fУбить &dСтража",
  "quest.7BCC2E37198682F8.quest_desc": [
    "Получите предмет с зачарованием X уровня."
  ],
  "quest.20D7DA6055C540FA.title": "&6Bounty Board",
  "quest.05B051603AC63B5A.quest_desc": [
    "Зачаруйте предмет с максимальными характеристиками и квантовой стабильностью."
  ],
  "task.05BA59C2F9E1F43B.title": "&fУбить 10 &cПылает",
  "quest.5C2C0986D6014ADD.quest_desc": [
    "Каждый день все &aСтранствующие Торговцы&r собираются на встречу. Они обсуждают, каким игрокам могут понадобиться их услуги и когда они готовы помочь. В их профессии входят различные полезные предметы, такие как &aспециальная трава&r для быстрого создания существ или &2заимствованная технология&r для запуска расширенного хранилища.",
    "",
    "Они имеют добрые намерения, хотя часто не понимают, где появляются, и не могут определить, когда игроку больше не нужна их помощь.",
    "",
    "Вы можете использовать команду",
    "&b/переключение событий ftb:wandering_trader",
    "чтобы дать им знать, нужны они или нет."
  ],
  "quest.2EE5352D8E5F715F.title": "&fУбить 20 &cПауков",
  "quest.708DD6CD3AE7F0FE.title": "&fУбить 10 &cСкелетов-иссушителей",
  "quest.34C8824842867F5D.title": "&fУбить &dЭндер Дракона",
  "quest.5918EA666DF20DA4.quest_desc": [
    "Тысяча часов — это примерно шесть недель непрерывной игры. Если вы получите это, мы хотели бы услышать, как это сделать."
  ],
  "quest.6964408274A7ACF7.title": "Играйте &a10 часов",
  "quest.77F964631F38EA2E.quest_desc": [
    "&cКрипер&r, который взрывается сам, не засчитывается. Убейте его, прежде чем он перестанет шипеть."
  ],
  "quest.7A8669713BE28E8F.quest_desc": [
    "Хранители тишины &3Древних городов&r. Привлекайте к себе внимание на свой страх и риск."
  ],
  "quest.67078BCAD52BC4B4.title": "&fУбить 20 &cСлизней",
  "quest.7D23D1C9DE75721F.quest_desc": [
    "Щит блокирует их стрелы. Бродячие и болотные — отдельные мобы и здесь не учитываются."
  ]
}
