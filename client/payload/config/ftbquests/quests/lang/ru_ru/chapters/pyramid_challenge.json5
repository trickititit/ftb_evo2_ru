{
  "task.723B25C8404ECDE6.title": "Убейте любого &5Ars Magica Стража&r или &5Witchery Босса&r.",
  "quest.74EBD1E63235A9E7.title": "&dСвязанная сущность",
  "quest.686C88AC0EAC0580.quest_desc": [
    "Запустите &aЗвездные карты&r через &6FTB Skyline&r. &aЗвериный разум&r тоже их использует."
  ],
  "quest.0F00A9F0A7B3E5AB.title": "&9Антиматерия",
  "quest.271D33449195EF70.title": "&cЧетвертая фаза: Сердце",
  "quest.3AD6C1611BE808AC.title": "&cFeed The Beast",
  "quest.6AA6C01368D6E51F.quest_desc": [
    "&aРунические пластины&r изготавливаются на &2Верстак&r, по две на каждое ремесло, из &aСлитков иесния&r, &aОчищенная пыль Винтеума&r, &aПорошок роста&r, a &aКамень темной силы&r и &aСолнечный камень&r.",
    "",
    "&aОчищенная пыль Винтеума&r требует &2Церублоссом&r и Кольцо пустыни. Выращивайте их в &eLTX&r &aБио/АРУ Сад&r или &eFTB Industrial Contraptions&r &2Гидропонный ускоритель&r вместо того, чтобы собирать их вручную."
  ],
  "quest.207C8D7ECDE970C7.title": "&bЛогическая решетка",
  "quest.0F00A9F0A7B3E5AB.quest_desc": [
    "Топливные ядра изготавливаются в &eLTX&r &2Ассемблере&r, и каждый корабль требует &aАнтиматерия&r.",
    "",
    "Антиматерия поступает из &eFTB Industrial Contraptions&r &aКонструктор антиматерии&r, для создания каждой части которого требуется много энергии. Если подать ему &aМеталлолом&r или &2Ящики для лома&r, это ускоряется."
  ],
  "quest.3ED3A5C17426409C.quest_desc": [
    "Запустите &aМатрицы хранения&r через &6FTB Skyline&r. &aКогнитивный массив&r тоже использует их."
  ],
  "quest.75377F96CF3D0542.quest_desc": [
    "&aСвязанная сущность&r изготавливается из &eNeo Vitae&r &2Адский огонь Forge&r, по два на каждое ремесло. Кузница истощает волю демона, поэтому держите под рукой большой запас."
  ],
  "quest.3424B583F08C904E.title": "&9Зарядная ячейка",
  "quest.43254C6DA652CD80.quest_desc": [
    "Чтобы создать &aДуша Зверя&r, вам нужны &2Завет Души&r, Причинный Якорь и Тайный Кодекс. Запустите один через &6FTB Skyline&r."
  ],
  "quest.6AA6C01368D6E51F.title": "&dРунная резьба",
  "quest.28F13C084F290510.title": "&bКаузальный якорь",
  "quest.0F938273B444DCC6.quest_desc": [
    "Запустите &aЖивые культуры&r через &6FTB Skyline&r. &aЗвериное ядро&r тоже их использует."
  ],
  "quest.3865D1981A6C504A.quest_desc": [
    "&aЗнаки Охотника&r изготавливаются в &eEnder IO&r в &2Отрубатель и сращиватель&r, по два на каждое ремесло.",
    "",
    "&cВнимание&r: используйте пустую &aПустотная слеза&r. Тот, в котором хранятся предметы, израсходуется вместе со всем, что в нем хранится."
  ],
  "quest.2BE12C77F5A3B217.title": "&9Заряжено",
  "quest.66DA6CCD0EE57AF2.title": "&dТайный кодекс",
  "quest.378515D4213D1BA9.quest_desc": [
    "&aСтандарт охоты&r является компонентом задания «Охота». &6FTB Fabricator&r дает по два на корабль после завершения испытаний с боссом.",
    "",
    "Позже он попадает в &aЗвездная карта&r и &2Бездонная линза&r, а &cСердце Зверя&r снова запрашивает его."
  ],
  "quest.53B6E5AE4FF4A857.title": "&cЗвериный разум",
  "quest.596C7FC9FD418D10.quest_desc": [
    "&aРеликвия Дракона&r создается на &eHephaestus&r &2Стол для обжаренного литья&r. &aКость дракона&r занимает место заклинания и израсходуется, затем на него выливается &2Раскаленная огненная драконья сталь&r.",
    "",
    "Расплавьте &aОгненные слитки драконьей стали&r в плавильне, чтобы получить расплавленный металл."
  ],
  "quest.58087F42E353F1A7.title": "&dИндустрия душ",
  "quest.58087F42E353F1A7.quest_desc": [
    "&aЗавет Души&r использует одновременно пять магических модов: от &eNeo Vitae&r анализа крови до &eAnima&r кристаллов.",
    "",
    "Улучшенное &aОбещание&r не суммируется, поэтому держите по одному наготове для каждого ремесла."
  ],
  "quest.11523CC5811E7A35.quest_desc": [
    "Ваша первая сборка, &aЗвериное ядро&r, включает в себя &2Живая культура&r, Бездонную Линзу и Сверхплотную Антиматерию. Запустите один через &6FTB Skyline&r."
  ],
  "quest.2754B03A1C3C9790.quest_desc": [
    "Запустите &aТопливные ядра&r через &6FTB Skyline&r. &aДинамо Матрица&r тоже их использует."
  ],
  "quest.524F093A735BE7DD.quest_desc": [
    "&6FTB Fabricator&r — это первый шаг к главной цели пакета.",
    "",
    "Получается &6FTB Skyline&r &oи&r каждый компонент Feed The Beast вплоть до &cСердце Зверя&r.",
    "",
    "Он требует энергии и требует одновременно до девяти ингредиентов и двух жидкостей. Вам не нужно выбирать рецепт. Просто заполните входные данные, и Производитель запустит тот рецепт, который соответствует.",
    "",
    "Фабрикатор потребляет потребляемую мощность каждый такт, в отличие от других машин, работающих на буфере мощности. Если у него заканчивается электричество, корабль останавливается до тех пор, пока питание не вернется, поэтому убедитесь, что в рецептах поздней игры достаточно кабелей и места для хранения, чтобы не отставать."
  ],
  "quest.6657769447DCC151.quest_desc": [
    "&aЛогические решетки&r создаются в &eExtendedAE&r в &2Кристальный сборщик&r, по две на каждое ремесло.",
    "",
    "&eRefined Storage&r, &aРасширенные процессоры&r и &eAE2&r &2Инженерные процессоры&r оба работают. Если вы запускаете AE2, выберите маршрут AE2, так как он требует вдвое меньше процессоров."
  ],
  "quest.1AF9F40BC39B15E7.title": "&dЗавет Души",
  "quest.783B31D7CB5FECF3.quest_desc": [
    "Для второго испытания убейте либо &aКороля Грома&r, либо &2Ледяного Медведя&r. Любой из них завершает задание.",
    "",
    "FrostBear не появляется в дикой природе. Он ждет на &bЛедовой арене&r, которая генерируется в заснеженных и замороженных биомах. Найдите &9Ледовую арену&r с помощью &eКомпас исследователя&r, чтобы найти ближайшую."
  ],
  "quest.1680E39D555B6F9D.quest_desc": [
    "Для &aПричинный якорь&r нужны кристаллы времени и механизмы из &eJust Dire Things&r, из &eOritech&r — &2Поглотитель тахионов&r, а также «Нова» из &eLTX&r.",
    "",
    "&aКристаллы Времени&r вырастают из разрастающегося блока Кристалла Времени, поэтому установите его заранее."
  ],
  "task.530E9F4F71784E0C.title": "Убейте &aКороля Грома&r или &2Ледяного Медведя&r.",
  "quest.303158D55BB8EB0A.quest_desc": [
    "Последнее испытание — магический босс. Любой страж &eArs Magica&r учитывается, как и Смерть &eWitchery&r, Галг, Рогатый Охотник, Леонард и Мог.",
    "",
    "Завершение этого задания открывает рецепт &aСтандарт охоты&r в &6FTB Fabricator&r."
  ],
  "quest.32BF6878128A4A41.quest_desc": [
    "&aКогнитивный массив&r — это компонент пути логистического задания. &6FTB Fabricator&r дает по два на корабль.",
    "",
    "&aЗвездная карта&r, &2Живая культура&r и Звериный Разум используют его позже."
  ],
  "quest.53B6E5AE4FF4A857.quest_desc": [
    "&aЗвериный разум&r берет &2Звездная карта&r, Причинный якорь и Массив познания. Запустите один через &6FTB Skyline&r."
  ],
  "quest.547E150FD212CE6A.quest_desc": [
    "&aМатрицы хранения&r сделаны в &eAdvancedAE&r's &2Реакционная камера&r с менриловой смолой, по два на крафт.",
    "",
    "&eRefined Storage&r, &aЧасть хранения на 64К&r или &eAE2&r &216К МЭ компонент хранения&r оба работают. Рецепт AE2 рассчитан на три."
  ],
  "quest.32BF6878128A4A41.title": "&bКогнитивный массив",
  "quest.28F13C084F290510.quest_desc": [
    "Запустите &aПричинные якоря&r через &6FTB Skyline&r. И &aЗвериный разум&r, и &2Душа Зверя&r используют их, так что сделайте больше."
  ],
  "quest.75377F96CF3D0542.title": "&dСвязанные огнём",
  "quest.783B31D7CB5FECF3.title": "&3Буря или мороз",
  "quest.4E1BD5A8A30FD48F.quest_desc": [
    "Запустите &aЗнаки Охотника&r через &6FTB Skyline&r. Сделайте запасные части, так как &aСтандарт охоты&r тоже их использует."
  ],
  "quest.378515D4213D1BA9.title": "&3Стандарт охоты",
  "quest.3CEEE30B0E586B61.title": "&6Решетка из квантового сплава",
  "quest.303158D55BB8EB0A.title": "&3Чародейский враг",
  "quest.27EC7598ED066BB9.title": "&cФаза вторая: Комбинации",
  "quest.337013B1E6098B0F.title": "&9За пределами атмосферы",
  "quest.51090593521196EA.title": "&dРуническая пластина",
  "quest.7B97384DD7B5F13A.quest_desc": [
    "Рецепт &aСтандарт охоты&r остаётся заблокированным до тех пор, пока ваша команда не проявит себя против трёх боссов. Первый — это &aУвядание&r.",
    "",
    "Убейте Иссушителя. Следующие испытания открываются одно за другим под этим заданием."
  ],
  "quest.51090593521196EA.quest_desc": [
    "Запустите &aРунические пластины&r через &6FTB Skyline&r. &aЧародейский кодекс&r тоже использует их."
  ],
  "quest.3CEEE30B0E586B61.quest_desc": [
    "Запустите &aРешетки квантового сплава&r через &6FTB Skyline&r. &aТектонический слиток&r тоже их использует."
  ],
  "quest.74EBD1E63235A9E7.quest_desc": [
    "Запустите &aСвязанная сущность&r через &6FTB Skyline&r. &aЧародейский кодекс&r тоже использует его."
  ],
  "quest.41767899815ED603.title": "&9Динамо Матрица",
  "quest.11523CC5811E7A35.title": "&cЯдро Зверя",
  "quest.524F093A735BE7DD.title": "&6FTB Fabricator",
  "quest.4E1BD5A8A30FD48F.title": "&3Знак Охотника",
  "quest.68CD3FB4B9D3E73C.title": "&6Давление на глубине",
  "quest.67653968F82D7015.quest_desc": [
    "&aКомпозитная обшивка корпуса&r собирается в &eOritech&r &2Ассемблере&r, по два на корабль. Каждый вход представляет собой полный блок или сплав, поэтому настройте для них хранилище."
  ],
  "quest.369A794CDF251519.title": "&3Реликвия Дракона",
  "quest.68CD3FB4B9D3E73C.quest_desc": [
    "Большая часть &aБездонная линза&r является результатом глубоководных разработок &eNautec&r.",
    "",
    "&aЛазерная направляющая катушка&r возникает в результате лазерной трансформации &2Сгоревшая катушка&r. &aПанцирь Кракена&r не складывается, поэтому рецепт требует по одному."
  ],
  "quest.2BE12C77F5A3B217.quest_desc": [
    "&aЗарядовые ячейки&r состоят из &ePowah&r &2Зарядная сфера&r. Каждый из них требует 20 000 000 FE, а стержни вокруг шара определяют, насколько быстро он движется."
  ],
  "quest.56B9F00E1A03D9E5.quest_desc": [
    "&aТектонический слиток&r — это материальный компонент пути задания. &6FTB Fabricator&r дает по два на корабль.",
    "",
    "Заработайте много. Три комбинации и &cСердце Зверя&r используют его больше, чем любой другой компонент пути."
  ],
  "quest.369A794CDF251519.quest_desc": [
    "Запустите &aDragon Relics&r через &6FTB Skyline&r. Сделайте запасные части для &aСтандарт охоты&r."
  ],
  "quest.6657769447DCC151.title": "&bРабота с решеткой",
  "quest.1AF9F40BC39B15E7.quest_desc": [
    "Запустите &aЗаветы Души&r через &6FTB Skyline&r. &aДуша Зверя&r тоже их использует."
  ],
  "quest.7E2819AC0B02950E.quest_desc": [
    "&aРешетки из квантового сплава&r изготавливаются в &eLTX&r &2Дуговая печь&r с использованием лавы, по две на каждый корабль."
  ],
  "quest.763DA227802CAF6B.quest_desc": [
    "Все пять комбинаций готовы. Получите этот задание, чтобы разблокировать рецепты &aЗвериное ядро&r, &2Звериный разум&r и Душа зверя.",
    "",
    "Каждая сборка рисует 5 000 000 FE за тик в течение минуты."
  ],
  "quest.686C88AC0EAC0580.title": "&9Звездная карта",
  "quest.57A4691609E10D24.quest_desc": [
    "Зверь никогда не бывает сытым надолго. Запустите по два компонента каждого пути и по одному из каждой комбинации через &6FTB Skyline&r, чтобы получить награду.",
    "",
    "Этот задание повторяется, поэтому работающая фабрика может продолжать платить."
  ],
  "quest.67653968F82D7015.title": "&6Корпусный состав",
  "quest.7E2819AC0B02950E.title": "&6Дуговые сплавы",
  "quest.56B9F00E1A03D9E5.title": "&6Тектонический слиток",
  "quest.523CFE289E14A7F4.title": "&6Композитная обшивка корпуса",
  "quest.27EC7598ED066BB9.quest_desc": [
    "Все пять компонентов пути готовы. Получите этот задание, чтобы разблокировать пять комбинированных рецептов в &6FTB Fabricator&r.",
    "",
    "Каждая комбинация приносит 1 000 000 FE за тик в течение минуты."
  ],
  "quest.596C7FC9FD418D10.title": "&3Реликвии Дракона",
  "quest.66DA6CCD0EE57AF2.quest_desc": [
    "&aЧародейский кодекс&r — это компонент пути пути задания волшебства. &6FTB Fabricator&r дает по два на корабль.",
    "",
    "&aЗавет Души&r, &2Причинный якорь&r и Душа Зверя используют его позже."
  ],
  "quest.0F938273B444DCC6.title": "&aЖивая культура",
  "quest.523CFE289E14A7F4.quest_desc": [
    "Запустите &aКомпозитная обшивка корпуса&r через &6FTB Skyline&r. &aТектонический слиток&r тоже использует его."
  ],
  "quest.271D33449195EF70.quest_desc": [
    "Все три сборки готовы. Получите этот задание, чтобы разблокировать рецепт &cСердце Зверя&r.",
    "",
    "Heart рисует 40 000 000 FE за тик в течение трех минут."
  ],
  "quest.3ED3A5C17426409C.title": "&bМатрица хранения",
  "quest.6DDEFBD9C262AA0B.title": "&aНакормите фабрики",
  "quest.3AD6C1611BE808AC.quest_desc": [
    "&aСердце Зверя&r объединяет все пути заданий.",
    "",
    "Доставьте Сердце, заполните отсеки для жидкости и энергии и нажмите &aЗапуск&r, чтобы закончить главу.",
    "",
    "Ваша команда получит &aЗвериный трофей&r и первые творческие предметы, а каждый участник сможет претендовать на шляпу, которой у него еще нет.",
    "",
    "&7&oПоздравляем и спасибо за игру FTB Evolution 2.&r"
  ],
  "quest.6DDEFBD9C262AA0B.quest_desc": [
    "&aЖивая культура&r объединяет три компонента пути с &eLTX&r, &2Реальный процессор виртуальности&r и сплавами других модов.",
    "",
    "&aСверхпроводникам&r нужен &2Кристаллизованный лазурит&r. &6FTB Fabricator&r делает его 32 за раз, гораздо быстрее, чем его рост, и с более высокими затратами."
  ],
  "quest.531E1581CAA5AF16.title": "&6Бездная линза",
  "quest.531E1581CAA5AF16.quest_desc": [
    "Запустите &aЛинзы бездны&r через &6FTB Skyline&r. &aЗвериное ядро&r тоже их использует."
  ],
  "quest.207C8D7ECDE970C7.quest_desc": [
    "Запустите &aЛогические решетки&r через &6FTB Skyline&r. &aКогнитивный массив&r тоже использует их."
  ],
  "quest.41767899815ED603.quest_desc": [
    "&aДинамо Матрица&r — это компонент пути пути силового задания. &6FTB Fabricator&r получается по два на корабль, и для этого требуется больше &aАнтиматерия&r.",
    "",
    "&aЖивая культура&r, &2Завет Души&r и Ядро Зверя используют его позже."
  ],
  "task.15CF6042AC24DDB1.title": "&aПродвинутый процессор&r или &aИнженерный процессор&r",
  "quest.2905D04F590BAC36.title": "&6FTB Skyline",
  "quest.43254C6DA652CD80.title": "&cДуша Зверя",
  "quest.3424B583F08C904E.quest_desc": [
    "Запустите &aЗарядные ячейки&r через &6FTB Skyline&r. &aДинамо Матрица&r тоже их использует."
  ],
  "quest.547E150FD212CE6A.title": "&bЧасти матрицы",
  "quest.3865D1981A6C504A.title": "&3Охотничьи трофеи",
  "quest.763DA227802CAF6B.title": "&cЭтап третий: Сборки",
  "quest.7B97384DD7B5F13A.title": "&3Первое испытание",
  "task.26E9F8319109DD27.title": "&aЧасть хранения на 64К&r или &a16К МЭ компонент хранения&r",
  "quest.1680E39D555B6F9D.title": "&bПротив причинности",
  "quest.2905D04F590BAC36.quest_desc": [
    "Это финал игры &6FTB Evolution 2&r.",
    "",
    "Чтобы &cзапустить&r все испытания &6Skyline&r, вам понадобится испытать почти все моды из пакета.",
    "",
    "Вы доставите все, закачав это в &6Skyline&r. Ему нужна свободная площадка размером 5 на 5, высотой 6 блоков, вид на небо, и использовать его может только ваша команда.",
    "",
    "- &aПредметы&r: отсеки со стороны консоли и сзади.",
    "- &aЖидкости&r: боковые отсеки с синими глифами.",
    "- &aЭнергия&r: боковые отсеки с зелеными глифами.",
    "",
    "{@pagebreak}",
    "Щелкните его правой кнопкой мыши, выберите задание и введите то, что он просит. Все, что поступает, используется, а все, что не нужно задаче, отбрасывается. Нажмите &aЗапуск&r, как только задание будет состоять из всех частей.",
    "",
    "Пять путей заданий могут быть разделены между игроками. Каждые фазовые врата под ними открывают следующий уровень рецептов Фабрикатора после выполнения каждого задания над ними."
  ],
  "quest.337013B1E6098B0F.quest_desc": [
    "&aЗвездная карта&r нуждается в деталях от Луны и двух новых энергоприемниках.",
    "",
    "- &aФортрон&r: &eMFFS&r &2Принуждающий Извлекатель&r превращает в него мощность.",
    "- &aСверхплотная антиматерия&r: &eFTB Industrial Contraptions&r &2Компрессор&r упаковывает 64 антиматерии в одну."
  ],
  "quest.2754B03A1C3C9790.title": "&9Топливное ядро",
  "quest.57A4691609E10D24.title": "&5Продолжение дани"
}
