{
  "quest.28BF66D1B8CD4D44.title": "&cКровь &dВеники",
  "quest.63AE4568375DD1BF.quest_subtitle": "Ваш собственный экологический аккумулятор",
  "quest.0BB0DF36B079558F.title": "&6Соединение крови",
  "quest.2CB69634F6A6E53E.quest_desc": [
    "Иногда в вашем мире вы можете найти простую структуру &9Темный Храм&r, от которой исходит луч света, уходящий высоко в небо.",
    "",
    "В середине &9Темного Храма&r вы найдете &aПогодный Аккумулятор&r, который вы можете использовать для усиления и создания нескольких предметов в моде &eEvilCraft&r.",
    "",
    "Бросив &3Погодный контейнер&r в &aПогодный Аккумулятор&r во время дождя или грозы, вы сможете использовать их силы для управления погодой по своему желанию."
  ],
  "task.2148DCC201648C0A.title": "Любая щетка для метлы",
  "quest.2CB69634F6A6E53E.title": "Темные храмы",
  "quest.525517F1625A9BCB.title": "Автоматизация сбора крови",
  "task.499D24D1F87BF794.title": "Любая шапочка от метлы",
  "quest.5A8F4CA0F09F4842.quest_desc": [
    "&dОчиститель&r позволяет снимать &5Чары&r и &cПроклятия&r с предметов, используя кровь.",
    "",
    "Вам понадобится как минимум 1 ведро крови в &dОчиститель&r, затем добавьте предмет, с которого хотите снять чары, и &cБлук&r, чтобы поглотить одно из чар предмета."
  ],
  "quest.68318811CCC28320.quest_desc": [
    "Чтобы продвинуться дальше в &eEvilCraft&r, вам нужно будет создать &3Blood Infusion Cores&r, которые являются одним из основных компонентов мода.",
    "",
    "Чтобы создать свой первый &2Камень темной силы&r, соберите как минимум 5 ведер крови, затем бросьте &aТёмный самоцвет&r в яму, содержащую как минимум 5 блоков крови, чтобы наполнить его.",
    "",
    "Чтобы получить &cЗатвердевшая Кровь&r, вы можете либо дать крови высохнуть, поместив ее в мир, либо в &2Сушильный бассейн&r. Разбив его с помощью &aОгниво&r, вы получите &dКровавые осколки&r."
  ],
  "task.241552F6DE892E6A.title": "Обещание обновлений",
  "quest.62A262A706CFCAF0.quest_desc": [
    "&cНаполнитель Кровью&r — это основная машина &eEvilCraft&r, которая наполняет предметы кровью.",
    "",
    "Теперь вы можете использовать его для создания &3Dark Power Gems&r.",
    "",
    "&cНаполнитель Кровью&r можно улучшить с помощью &bОбещания&r, которые будут рассмотрены в следующих нескольких заданиях."
  ],
  "quest.59036A2741E7A8AA.quest_desc": [
    "&9Раниматор Духов&r позволяет вам использовать пойманный дух для создания яйца призывания.",
    "",
    "Для этого потребуется довольно много &cКровь&r, Яйца и &dКоробка Вечного Закрытия&r с выбранным вами Духом.",
    "",
    "&7&oНе все яйца призывания мобов можно создать таким образом."
  ],
  "quest.4EBED8ABC8C863A4.quest_desc": [
    "Теперь вы можете использовать свой &cНаполнитель Кровью&r для создания последнего уровня улучшения мода, &bОбещание упорства III&r.",
    "",
    "Это разблокирует все оставшиеся рецепты и предметы в &eEvilCraft&r."
  ],
  "quest.066438B01655D866.quest_desc": [
    "Используя &dФокус мести&r, вы можете заморозить дух на месте, что позволит вам захватить его, поместив &3Коробка Вечного Закрытия&r рядом с ним."
  ],
  "quest.7B524DAD8A33BF85.title": "Полезные инструменты",
  "quest.62A262A706CFCAF0.title": "Устройство для закачки крови &c",
  "quest.1DA0A87C471A38AC.title": "Кровавые фермы мобов",
  "quest.28BF66D1B8CD4D44.quest_subtitle": "Метла Метла",
  "quest.35FA55BE8DF49EE8.title": "Гармонбозия",
  "quest.35FA55BE8DF49EE8.quest_desc": [
    "Используя &dдуха мести и его &bЭссенция&r, можно создать &6Гармонбозия&r в &cНаполнитель Кровью&r.",
    "",
    "Это один из основных ингредиентов, используемых в продвинутых рецептах &eEvilCraft&r."
  ],
  "quest.63AE4568375DD1BF.quest_desc": [
    "Используя &6Гармонбозия&r, вы теперь можете создать свой собственный &aПогодный Аккумулятор&r."
  ],
  "quest.51B24CC5E9332C1E.quest_desc": [
    "Иногда убийство моба порождает &dДух мести&r. Вам нужно будет поймать этих духов, чтобы создавать более сложные предметы (см. следующий задание).",
    "",
    "На данный момент, если вы изо всех сил пытаетесь найти этих духов, &2Кольцо мести&r может помочь вам привлечь их."
  ],
  "quest.63AE4568375DD1BF.title": "Кровавый аккумулятор окружающей среды",
  "quest.7E79F52147B606F9.quest_desc": [
    "Чтобы начать собирать кровь, вам нужно создать &cэкстрактор крови&r и начать убивать мобов.",
    "",
    "Он будет автоматически собирать кровь, когда вы убиваете мобов, и его объем крови можно увеличить, поэтому отметьте JEI, как только он начнет заполняться.",
    "",
    "Вы также можете использовать их для извлечения крови непосредственно из &cПятна крови&r на земле."
  ],
  "quest.31FD9EA513E0D010.title": "От Welcome до &eEvilCraft&r!",
  "quest.0BB0DF36B079558F.quest_desc": [
    "&6Кубок Запутывания&r можно использовать для подачи крови к предметам в вашем инвентаре.",
    "",
    "Для этого просто поместите один в мир и дайте ему &cКровь&r. Затем активируйте тот, который находится в вашем инвентаре.",
    "",
    "Если вы хотите использовать более 2 &6Чаш&r в одной сети, просто используйте альтернативный рецепт крафта, в котором вместо Золотого слитка в центре рецепта используется Чаша."
  ],
  "quest.40888A2C17D8FFF6.quest_desc": [
    "С помощью &cНаполнитель Кровью&r теперь вы можете сделать &cСаженцы нежити&r.",
    "",
    "Древесина этих деревьев полезна для создания нескольких инструментов и предметов в пределах &eEvilCraft&r."
  ],
  "quest.4978A9B616362CCE.title": "&aРанг 2&r: Больше &cКровь",
  "quest.62CE0FFAF6352287.quest_desc": [
    "&eEvilCraft&r машины можно улучшить с помощью &bОбещаний&r, каждое из которых имеет разные эффекты.",
    "",
    "Начните с создания &bОбещание упорства I&r. Это увеличивает емкость устройства и открывает больше рецептов &cНаполнитель Кровью&r.",
    "",
    "Вы также можете модернизировать свои машины с помощью &aОбещание продуктивности&r или &2Обещание скорости&r, которые повышают эффективность и скорость ваших машин."
  ],
  "quest.6B7C016407F7AE3C.quest_desc": [
    "Как вы видели, обычное оружие не может нанести урон &dДухам мести&r. Создайте и выстрелите в них &6Пронзающим лучом мести&r, чтобы убить их.",
    "",
    "При этом упадет их &aЭссенция&r, которая используется для более сложных рецептов."
  ],
  "quest.68318811CCC28320.title": "&aИнфузионные ядра",
  "quest.7B524DAD8A33BF85.quest_desc": [
    "&3Жиловой меч&r собирает больше крови от убийств мобов и поставляется с чарами &bГрабеж II&r.",
    "",
    "&3Кирка мести&r поставляется с Fortune V, но может вызывать мстительных духов во время добычи полезных ископаемых."
  ],
  "quest.4EBED8ABC8C863A4.title": "&aРанг 3&r: Еще больше &cКровь",
  "quest.6B7C016407F7AE3C.quest_subtitle": "Убийство духов мести",
  "quest.525517F1625A9BCB.quest_desc": [
    "Если вы хотите автоматизировать кровопролитие с помощью фермы мобов, просто поместите &2Шипованная Пластина&r на вершину &aСангвинарный пьедестал&r и пусть ваши мобы встанут или упадут на нее."
  ],
  "quest.51B24CC5E9332C1E.title": "Месть &dдухов",
  "task.73427CBDD811273E.title": "Любая метла",
  "quest.066438B01655D866.title": "Захват &dдухов",
  "quest.600F66B13B29708B.quest_desc": [
    "&zОбновленная плоть&r предоставляет вам бесконечный источник пищи, потребляющий кровь.",
    "",
    "&3Гуманоидная плоть&r выпадает, когда игрок умирает, а &dПлоть оборотня&r можно найти в деревнях."
  ],
  "quest.5A8F4CA0F09F4842.title": "Очистка предметов",
  "quest.28BF66D1B8CD4D44.quest_desc": [
    "&dМеты&r состоят из трёх отдельных частей: стержня, колпачка и щетки.",
    "",
    "Каждая часть создается путем объединения ее с другими предметами, которые изменяют эту часть. Полный список см. в путеводителе &6Происхождение тьмы&r.",
    "",
    "Когда у вас будут все детали, просто поместите каждую часть на верстак, чтобы собрать &dМетла&r, для работы которой потребуется &cКровь&r."
  ],
  "quest.4D7B6842B9F53459.quest_desc": [
    "Кольцо &dЛегкое кольцо&r увеличивает скорость, прыжки и высоту шага, когда оно находится в вашем инвентаре или установлено в слот для кольца."
  ],
  "quest.7E79F52147B606F9.title": "Сбор &cКрови",
  "quest.40888A2C17D8FFF6.title": "Нежить Деревья",
  "quest.4978A9B616362CCE.quest_desc": [
    "Имея доступ к большему количеству рецептов, ваш &cНаполнитель Кровью&r теперь можно использовать для создания &bОбещание упорства II&r.",
    "",
    "Это откроет еще больше рецептов, еще больше увеличит емкость машины и предоставит доступ к &dПечь Духов&r, используемой для создания собственных ферм мобов."
  ],
  "task.7DE03D4A420D1028.title": "&eНайти&r: &aТёмный храм",
  "quest.59036A2741E7A8AA.title": "&aСоздание &9яиц призывания",
  "quest.62CE0FFAF6352287.title": "&aОбновление машин",
  "quest.31FD9EA513E0D010.quest_desc": [
    "&eEvilCraft&r — магический мод, основанный на сборе крови мобов.",
    "",
    "Для начала займитесь добычей &aDark Gems&r.",
    "",
    "[\"\", \"Улавливание духов, воскрешение мертвых и Булава искажения также повышают ваш уровень. \", {\"text\": \"Дерево магических навыков\", \"color\": \"aqua\", \"underlined\": true, \"click_event\": {\"action\": \"custom\", \"id\": \"ftbquests:docs\", \"payload\": {\"location\": \"guideme,ftb:skills,ftb:magic.md\"}}, \"hover_event\": {\"action\": \"show_text\", \"value\": \"Открыть руководство по навыкам\"}}, \".\"]"
  ],
  "quest.1DA0A87C471A38AC.quest_desc": [
    "Чтобы создать собственную &eEvilCraft&r ферму мобов, вам понадобится как минимум 33 &aКирпича Темной крови&r, чтобы построить структуру для призванных духов, и &9Коробка Вечного Закрытия&r с выбранным вами духом.",
    "",
    "В самой структуре должно быть достаточно места для появления моба, поэтому минимальный размер — 3x4x3 для таких мобов, как зомби.",
    "",
    "Также не забудьте разместить &dПечь Духов&r на одной из его граней, чтобы взаимодействовать со структурой.",
    "",
    "Большим мобам, таким как Гасты и Крайники, потребуются более крупные структуры."
  ]
}
